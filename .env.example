# Add these as secret/environment values in the hosting dashboard.
# The application does not automatically load this example file.
BOT_TOKEN=
# Leave empty for the initial /id lookup; no user can administer until configured.
ADMIN_IDS=
# HTTPS origin only, without a path. Render supplies RENDER_EXTERNAL_URL automatically.
APP_URL=
BOT_USERNAME=
ACCESS_DB=/var/data/access.sqlite3
BOT_POLLING=1
INIT_DATA_MAX_AGE=86400
SUPPORT_TEXT=Свяжитесь с преподавателем, у которого получили доступ. / Contact the course owner for help.
